{
  "name": "BLC Mesa WordPress Workspace",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-containers",
        "streetsidesoftware.code-spell-checker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 2,
        "[php]": {
          "editor.tabSize": 4,
          "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
        },
        "intelephense.stubs": [
          "apache",
          "bcmath",
          "bz2",
          "calendar",
          "Core",
          "curl",
          "date",
          "dba",
          "dom",
          "enchant",
          "fileinfo",
          "filter",
          "ftp",
          "gd",
          "gettext",
          "hash",
          "iconv",
          "imap",
          "intl",
          "json",
          "ldap",
          "libxml",
          "mbstring",
          "mcrypt",
          "mysql",
          "mysqli",
          "password_compat",
          "pcntl",
          "pcre",
          "PDO",
          "Phar",
          "readline",
          "regex",
          "session",
          "SimpleXML",
          "soap",
          "sockets",
          "sodium",
          "standard",
          "superglobals",
          "tokenizer",
          "xml",
          "xdebug",
          "xmlreader",
          "xmlwriter",
          "yaml",
          "zip",
          "zlib",
          "wordpress"
        ]
      }
    }
  },
  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": {
      "label": "WordPress Site & Gutenberg Admin",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "phpMyAdmin Database Manager",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash scripts/init-site.sh || true"
}
