{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "name": "Obsidian Night",
          "slug": "obsidian",
          "color": "#0C1017"
        },
        {
          "name": "Midnight Slate",
          "slug": "midnight-slate",
          "color": "#151D28"
        },
        {
          "name": "Heritage Navy",
          "slug": "primary",
          "color": "#1B365D"
        },
        {
          "name": "Deep Midnight",
          "slug": "navy-dark",
          "color": "#0E2138"
        },
        {
          "name": "Radiant Gold",
          "slug": "accent",
          "color": "#D49B28"
        },
        {
          "name": "Warm Gold Soft",
          "slug": "gold-soft",
          "color": "#F5E6D3"
        },
        {
          "name": "Gold Glow",
          "slug": "gold-glow",
          "color": "#E8B85A"
        },
        {
          "name": "Cozy Alabaster (Background)",
          "slug": "cream",
          "color": "#FAF8F5"
        },
        {
          "name": "Warm Gray Card",
          "slug": "warm-gray",
          "color": "#EFECE6"
        },
        {
          "name": "Pure White",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Soft Charcoal Text",
          "slug": "dark",
          "color": "#2C3539"
        },
        {
          "name": "Muted Slate Text",
          "slug": "muted",
          "color": "#8E9AAB"
        },
        {
          "name": "Hope Sage",
          "slug": "sage",
          "color": "#4A6B5D"
        },
        {
          "name": "Terracotta",
          "slug": "terracotta",
          "color": "#B85D38"
        }
      ],
      "gradients": [
        {
          "name": "Gold Divider Glow",
          "slug": "gold-divider",
          "gradient": "linear-gradient(90deg, rgba(212,155,40,0) 0%, rgba(212,155,40,0.85) 50%, rgba(212,155,40,0) 100%)"
        },
        {
          "name": "Gold Button",
          "slug": "gold-button",
          "gradient": "linear-gradient(180deg, #E5A835 0%, #C0851D 100%)"
        },
        {
          "name": "Hero Vignette",
          "slug": "hero-vignette",
          "gradient": "linear-gradient(180deg, rgba(12,16,23,0.35) 0%, rgba(12,16,23,0.6) 60%, rgba(12,16,23,0.95) 100%)"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Warm Classic Serif",
          "slug": "serif",
          "fontFamily": "Cinzel, 'Playfair Display', Georgia, 'Times New Roman', Cambria, Garamond, serif"
        },
        {
          "name": "Elegant Script",
          "slug": "script",
          "fontFamily": "'Great Vibes', 'Alex Brush', 'Dancing Script', 'Playfair Display', cursive, serif"
        },
        {
          "name": "Modern Clean Sans",
          "slug": "sans",
          "fontFamily": "Montserrat, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.0625rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.35rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "1.875rem"
        },
        {
          "name": "Hero Title",
          "slug": "2x-large",
          "size": "2.6rem"
        },
        {
          "name": "Grand Hero",
          "slug": "3x-large",
          "size": "3.3rem"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "name": "1 - Tiny",
          "slug": "10",
          "size": "0.5rem"
        },
        {
          "name": "2 - Small",
          "slug": "20",
          "size": "1rem"
        },
        {
          "name": "3 - Medium",
          "slug": "30",
          "size": "1.75rem"
        },
        {
          "name": "4 - Large",
          "slug": "40",
          "size": "2.75rem"
        },
        {
          "name": "5 - Hero Spacing",
          "slug": "50",
          "size": "4.5rem"
        }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|cream",
      "text": "var:preset|color|dark"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|2x-large",
          "lineHeight": "1.22"
        },
        "color": {
          "text": "var:preset|color|navy-dark"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var:preset|color|primary"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|large",
          "lineHeight": "1.35"
        },
        "color": {
          "text": "var:preset|color|navy-dark"
        }
      },
      "h4": {
        "typography": {
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|medium"
        },
        "color": {
          "text": "var:preset|color|primary"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.85rem",
            "bottom": "0.85rem",
            "left": "1.75rem",
            "right": "1.75rem"
          }
        },
        "border": {
          "radius": "6px"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|small"
        }
      }
    }
  }
}
