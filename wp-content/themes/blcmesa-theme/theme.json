{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "840px",
      "wideSize": "1200px"
    },
    "color": {
      "palette": [
        {
          "name": "Navy Primary",
          "slug": "primary",
          "color": "#1A365D"
        },
        {
          "name": "Navy Dark",
          "slug": "navy-dark",
          "color": "#0F2038"
        },
        {
          "name": "Desert Gold Accent",
          "slug": "accent",
          "color": "#D69E2E"
        },
        {
          "name": "Warm Off-White",
          "slug": "light",
          "color": "#F7FAFC"
        },
        {
          "name": "Pure White",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Slate Text",
          "slug": "dark",
          "color": "#2D3748"
        },
        {
          "name": "Subtle Gray",
          "slug": "gray-subtle",
          "color": "#E2E8F0"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "System Sans",
          "slug": "sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        },
        {
          "name": "Classic Serif",
          "slug": "serif",
          "fontFamily": "Georgia, Cambria, 'Times New Roman', Times, serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.875rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.25rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "1.75rem"
        },
        {
          "name": "Huge",
          "slug": "2x-large",
          "size": "2.25rem"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "name": "Tiny",
          "slug": "10",
          "size": "0.5rem"
        },
        {
          "name": "Small",
          "slug": "20",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "30",
          "size": "1.5rem"
        },
        {
          "name": "Large",
          "slug": "40",
          "size": "2.5rem"
        },
        {
          "name": "X-Large",
          "slug": "50",
          "size": "4rem"
        }
      ],
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|dark"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|2x-large",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var:preset|color|navy-dark"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var:preset|font-family|serif",
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var:preset|color|primary"
        }
      },
      "h3": {
        "typography": {
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|large"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|accent"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "border": {
          "radius": "4px"
        }
      }
    }
  }
}
