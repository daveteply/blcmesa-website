# ==============================================================================
# BLC Mesa (blcmesa.org) - Local Development Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values if needed.
# All services in docker-compose.yml read from these variables.

# Project Identifier
COMPOSE_PROJECT_NAME=blcmesa

# ------------------------------------------------------------------------------
# Host Port Mappings (Forwarded through WSL2 to Windows 11 localhost)
# ------------------------------------------------------------------------------
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081
DB_PORT=3306

# ------------------------------------------------------------------------------
# MariaDB Database Configuration
# ------------------------------------------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress_dev_password
MYSQL_ROOT_PASSWORD=wordpress_root_dev_password
DB_HOST=db:3306

# ------------------------------------------------------------------------------
# WordPress Installation & Admin Credentials (used by scripts/init-site.sh)
# ------------------------------------------------------------------------------
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=Bethlehem Lutheran Church
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_password
WP_ADMIN_EMAIL=admin@blcmesa.org
WP_TIMEZONE=America/Phoenix
WP_ACTIVE_THEME=blcmesa-theme

# ------------------------------------------------------------------------------
# WordPress Debug Mode
# ------------------------------------------------------------------------------
WORDPRESS_DEBUG=1

# ------------------------------------------------------------------------------
# Contact Form Testing & Email Routing
# ------------------------------------------------------------------------------
# Optional: Set to your personal email to route all contact submissions directly
# to your inbox during development. If empty, submissions are mocked in console.info.
BLC_TEST_EMAIL=

# Optional: To actually send live emails from Docker using your personal Gmail/Yahoo account:
# For Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls

